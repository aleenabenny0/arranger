# Placeholders only. Real values live in the host's secret store, never in git.
# The API refuses to start in production when a rule marked (validated) is broken.

# Deployment environment; "production" turns on startup validation, HSTS and secure defaults.
APP_ENV=production
# Python log level for the arranger_api logger (JSON lines on stderr).
LOG_LEVEL=INFO
# Public https URL of the site; email links are built from it. (validated: required, https)
PUBLIC_BASE_URL=https://your-arranger-domain.example
# Bind address for uvicorn.
HOST=0.0.0.0
# Bind port; most hosts inject this.
PORT=8000
# Uvicorn auto-reload; never in production.
RELOAD=false
# Build identifier reported by /version (Railway and GitHub set their own variants).
COMMIT_SHA=unknown

# Comma-separated exact https origins of the frontend; used for CORS and the Origin check. (validated: no *, no null, https only)
FRONTEND_ORIGINS=https://your-arranger-domain.example
# Directory of the built static frontend served from "/".
FRONTEND_DIR=/app/frontend

# Postgres connection URL. (validated: SQLite is refused unless ALLOW_SQLITE_IN_PRODUCTION=true)
DATABASE_URL=postgresql://arranger:change-me@postgres:5432/arranger
# Apply migrations when the web process starts; set false to run `python -m arranger_api.storage.migrate` as a release step.
RUN_MIGRATIONS_ON_STARTUP=true
# Maximum simultaneous Postgres connections per process.
DB_POOL_SIZE=5
# Seconds a request waits for a free connection before answering 503.
DB_POOL_TIMEOUT_SECONDS=10
# Seconds after which a pooled connection is retired and replaced.
DB_POOL_MAX_LIFETIME_SECONDS=1800
# Server-side statement timeout applied to every Postgres connection.
DB_STATEMENT_TIMEOUT_MS=15000
# How long a SQLite writer waits for the lock (only relevant when SQLite is allowed).
SQLITE_BUSY_TIMEOUT_MS=5000

# Send session and CSRF cookies over https only. (validated: must be true)
COOKIE_SECURE=true
# Require the session-bound CSRF token and the Origin allow-list on unsafe requests. (validated: must be true)
CSRF_PROTECTION=true
# Absolute session lifetime in days.
SESSION_DAYS=30
# A session unused for this many days stops working even if not yet expired.
SESSION_IDLE_DAYS=14
# Minimum seconds between writes of a session's last-seen time.
SESSION_TOUCH_SECONDS=300
# Active sessions kept per user; the oldest are revoked beyond this.
MAX_SESSIONS_PER_USER=5
# Seconds between sweeps that delete dead sessions, spent tokens and old rate-limit windows.
CLEANUP_INTERVAL_SECONDS=3600

# Argon2id iterations (OWASP baseline: 2).
ARGON2_TIME_COST=2
# Argon2id memory in KiB (OWASP baseline: 19456 = 19 MiB).
ARGON2_MEMORY_KIB=19456
# Argon2id lanes.
ARGON2_PARALLELISM=1

# Number of reverse proxies in front of the app; 0 ignores X-Forwarded-For entirely. Set 1 on Railway.
TRUSTED_PROXY_COUNT=1
# Where rate-limit counters live: "database" is shared by all instances, "memory" is per process.
RATE_LIMIT_BACKEND=database
# Write requests allowed per window, per client and route.
RATE_LIMIT_REQUESTS=120
# Window for RATE_LIMIT_REQUESTS, in seconds.
RATE_LIMIT_WINDOW_SECONDS=60
# GET requests allowed per window, per client and route.
READ_RATE_LIMIT_REQUESTS=600
# Window for READ_RATE_LIMIT_REQUESTS, in seconds.
READ_RATE_LIMIT_WINDOW_SECONDS=60
# /auth write requests allowed per window, per client and route.
AUTH_RATE_LIMIT_REQUESTS=20
# Window for AUTH_RATE_LIMIT_REQUESTS, in seconds.
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
# Password-reset emails that can be requested per window.
PASSWORD_RESET_RATE_LIMIT_REQUESTS=5
# Window for PASSWORD_RESET_RATE_LIMIT_REQUESTS, in seconds.
PASSWORD_RESET_RATE_LIMIT_WINDOW_SECONDS=300
# Verification emails a user can re-request per window.
EMAIL_RESEND_RATE_LIMIT_REQUESTS=3
# Window for EMAIL_RESEND_RATE_LIMIT_REQUESTS, in seconds.
EMAIL_RESEND_RATE_LIMIT_WINDOW_SECONDS=600
# Requests to the upload prefixes allowed per window per client, checked before the body is read.
UPLOAD_RATE_LIMIT_REQUESTS=30
# Window for UPLOAD_RATE_LIMIT_REQUESTS, in seconds.
UPLOAD_RATE_LIMIT_WINDOW_SECONDS=60
# Hard cap on in-memory rate-limit buckets per process.
RATE_LIMIT_MAX_BUCKETS=50000

# Largest request body accepted on ordinary routes, in bytes.
MAX_REQUEST_BYTES=1000000
# Largest request body accepted under UPLOAD_PATH_PREFIXES, in bytes (40 MiB).
MAX_UPLOAD_BYTES=41943040
# Comma-separated path prefixes that get the upload body limit.
UPLOAD_PATH_PREFIXES=/imports,/projects

# Email provider. (validated: "console" is refused in production)
EMAIL_PROVIDER=resend
# Resend API key. (validated: required when EMAIL_PROVIDER=resend)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
# Verified sender address for all account email.
PASSWORD_RESET_FROM=Arranger <no-reply@your-arranger-domain.example>
# Subject line of password-reset email.
PASSWORD_RESET_SUBJECT=Reset your Arranger password
# Minutes a password-reset link stays valid.
PASSWORD_RESET_MINUTES=30
# Subject line of address-verification email.
EMAIL_VERIFICATION_SUBJECT=Verify your Arranger email address
# Minutes an address-verification link stays valid.
EMAIL_VERIFICATION_MINUTES=1440
# Require a verified address for expensive operations (renders and runs).
REQUIRE_VERIFIED_EMAIL=true

# Bearer token for GET /metrics and GET /diagnostics/email; leave empty to disable both (404).
METRICS_TOKEN=change-me-to-a-long-random-string
# Where uploaded and generated files are kept: local, database or s3.
ARTIFACT_BACKEND=database
# Directory for ARTIFACT_BACKEND=local; must be absolute and on a persistent volume.
ARTIFACT_DIR=/data/artifacts
# S3-compatible endpoint URL, only for ARTIFACT_BACKEND=s3.
S3_ENDPOINT=
# Bucket name, only for ARTIFACT_BACKEND=s3.
S3_BUCKET=
# Bucket region; "auto" suits Cloudflare R2.
S3_REGION=auto
# Access key id for the bucket. Set it in the host's secret store, not here.
S3_ACCESS_KEY=
# Secret key for the bucket. Set it in the host's secret store, not here.
S3_SECRET_KEY=
# Days to keep uploaded originals after import; 0 keeps them forever.
UPLOAD_RETENTION_DAYS=30
# Days to keep generated MIDI, MusicXML and PDF files; 0 keeps them forever.
EXPORT_RETENTION_DAYS=0
# Background workers inside each API process; 0 if you run arranger_api.worker separately.
JOB_WORKERS=1
# Where "job is ready" messages go: database (workers poll the jobs table), sqs, or memory (one process, never in production).
JOB_QUEUE_BACKEND=database
# The SQS work queue (JOB_QUEUE_BACKEND=sqs); `python -m arranger_api.queue --create NAME` prints it. See docs/async-jobs.md.
SQS_QUEUE_URL=
# The dead-letter queue messages go to after JOB_QUEUE_MAX_RECEIVES failed deliveries.
SQS_DEAD_LETTER_QUEUE_URL=
# SQS-compatible endpoint for LocalStack; leave empty for AWS.
AWS_ENDPOINT_URL=
# AWS region of the queues; credentials come from the environment or the instance role.
AWS_REGION=
# Seconds a received message stays invisible to other workers; 0 derives it from the slowest job limit plus a margin.
JOB_VISIBILITY_SECONDS=0
# Deliveries before a message is moved to the dead-letter queue.
JOB_QUEUE_MAX_RECEIVES=3
# Seconds a worker may go silent before its job is handed to another worker.
JOB_LEASE_SECONDS=120
# Times a job is attempted before it is marked failed.
JOB_MAX_ATTEMPTS=2
# Days finished jobs stay in the queue table for inspection.
JOB_RETENTION_DAYS=30
# Wall-clock limit for one arrangement job, in seconds.
ARRANGE_MAX_SECONDS=180
# Wall-clock limit for one PDF engraving job, in seconds.
ENGRAVE_MAX_SECONDS=120
# Wall-clock limit for one audio transcription job, in seconds.
TRANSCRIBE_MAX_SECONDS=900
# Most projects one account may hold.
QUOTA_PROJECTS=200
# Most bytes of stored files one account may hold.
QUOTA_STORAGE_BYTES=524288000
# Most background jobs one account may start in 24 hours.
QUOTA_JOBS_PER_DAY=200
# Most audio transcriptions one account may start in 24 hours.
QUOTA_TRANSCRIPTIONS_PER_DAY=20
# Most jobs one account may have queued or running at once.
QUOTA_ACTIVE_JOBS=3
# Let a Claude model try to improve arrangements. Costs money; needs ANTHROPIC_API_KEY.
MODEL_REPAIR_ENABLED=false
# Model id for repair; blank uses the engine's default.
ARRANGER_MODEL=
# Most model attempts per arrangement.
MODEL_MAX_ATTEMPTS=3
# Most US dollars of model spend per arrangement.
MODEL_MAX_COST_USD=0.25
# Legal name of whoever operates this service, printed on the legal pages.
OPERATOR_NAME=
# Public support contact, printed on the support page.
OPERATOR_CONTACT_EMAIL=
# Postal address of the operator, if your jurisdiction requires one.
OPERATOR_POSTAL_ADDRESS=
# Governing law and venue, as advised by your lawyer.
OPERATOR_JURISDICTION=
# Where privacy and data requests go.
PRIVACY_CONTACT_EMAIL=
# Where copyright complaints go.
DMCA_CONTACT_EMAIL=
# Where user data is stored, e.g. "EU (Frankfurt)".
DATA_REGION=
# Set true only when every operator detail above is filled in; startup fails otherwise.
PUBLIC_LAUNCH=false
