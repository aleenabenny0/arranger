APP_ENV=production
HOST=0.0.0.0
PORT=8000
RELOAD=false
COOKIE_SECURE=true
SESSION_DAYS=30
MAX_SESSIONS_PER_USER=5
CSRF_PROTECTION=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
PASSWORD_RESET_MINUTES=30
FRONTEND_ORIGINS=https://your-arranger-domain.example
FRONTEND_DIR=/app/frontend
DATABASE_URL=postgresql://arranger:change-me@postgres:5432/arranger
